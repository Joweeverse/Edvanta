{
  "info": {
    "name": "Edvanta Classroom Service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://edvanta.stei.site/api"
    },
    {
      "key": "apiKey",
      "value": "ISI_API_KEY"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Umum",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Autentikasi",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/records",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "records"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"siswa@example.com\",\n  \"password\": \"minimal8kar\",\n  \"passwordConfirm\": \"minimal8kar\",\n  \"name\": \"Siswa\",\n  \"role\": \"student\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/auth-with-password",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "auth-with-password"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identity\": \"siswa@example.com\",\n  \"password\": \"minimal8kar\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.token) { pm.collectionVariables.set('token', j.token); pm.collectionVariables.set('userId', j.record.id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/auth-refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "auth-refresh"
              ]
            }
          }
        }
      ]
    },
